{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outlaw Forge",
  "version": "0.1.0",
  "identifier": "com.outlawforge.workbench",
  "build": {
    "frontendDist": "../apps/web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev --workspace=apps/web",
    "beforeBuildCommand": "npm run build --workspace=apps/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Outlaw Forge 3D Preparation Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/outlaw_forge_sidecar"
    ]
  },
  "plugins": {
    "dialog": {},
    "shell": {},
    "process": {}
  }
}
